<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="hello.corebanking.domain.product.repository.InterestTypeMapper">

    <resultMap id="interestTypeResultMap" type="hello.corebanking.domain.product.entity.InterestType">
        <id     property="interestTypeId" column="interest_type_id"/>
        <result property="name"           column="name"/>
        <result property="createdAt"      column="created_at"/>
        <result property="updatedAt"      column="updated_at"/>
    </resultMap>

    <insert id="insert" parameterType="hello.corebanking.domain.product.entity.InterestType"
            useGeneratedKeys="true" keyProperty="interestTypeId">
        INSERT INTO interest_type (name)
        VALUES (#{name})
    </insert>

    <select id="findById" parameterType="int" resultMap="interestTypeResultMap">
        SELECT interest_type_id, name, created_at, updated_at
        FROM interest_type
        WHERE interest_type_id = #{interestTypeId}
    </select>

    <select id="findAll" resultMap="interestTypeResultMap">
        SELECT interest_type_id, name, created_at, updated_at
        FROM interest_type
        ORDER BY interest_type_id
    </select>

</mapper>
