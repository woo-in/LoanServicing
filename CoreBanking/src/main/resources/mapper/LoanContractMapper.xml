<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="hello.corebanking.domain.loan.repository.LoanContractMapper">

    <resultMap id="loanContractResultMap" type="hello.corebanking.domain.loan.entity.LoanContract">
        <id     property="loanContractId"         column="loan_contract_id"/>
        <result property="loanProductId"          column="loan_product_id"/>
        <result property="memberId"               column="member_id"/>
        <result property="contractDate"           column="contract_date"/>
        <result property="maturityDate"           column="maturity_date"/>
        <result property="contractPrincipal"      column="contract_principal"/>
        <result property="contractAdditionalRate" column="contract_additional_rate"/>
        <result property="contractBaseRate"       column="contract_base_rate"/>
        <result property="totalInstallments"      column="total_installments"/>
        <result property="createdAt"              column="created_at"/>
        <result property="updatedAt"              column="updated_at"/>
    </resultMap>

    <select id="findById" parameterType="long" resultMap="loanContractResultMap">
        SELECT loan_contract_id, loan_product_id, member_id,
               contract_date, maturity_date, contract_principal,
               contract_additional_rate, contract_base_rate, total_installments,
               created_at, updated_at
        FROM   loan_contract
        WHERE  loan_contract_id = #{loanContractId}
    </select>

    <select id="findByLoanAccountId" parameterType="long" resultMap="loanContractResultMap">
        SELECT lc.loan_contract_id, lc.loan_product_id, lc.member_id,
               lc.contract_date, lc.maturity_date, lc.contract_principal,
               lc.contract_additional_rate, lc.contract_base_rate, lc.total_installments,
               lc.created_at, lc.updated_at
        FROM   loan_contract lc
               INNER JOIN loan_account la ON la.loan_contract_id = lc.loan_contract_id
        WHERE  la.loan_account_id = #{loanAccountId}
    </select>

</mapper>
