<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="hello.corebanking.domain.customer.repository.PrimaryAccountMapper">

    <resultMap id="primaryAccountResultMap" type="hello.corebanking.domain.customer.entity.PrimaryAccount">
        <id     property="primaryAccountId" column="primary_account_id"/>
        <result property="memberId"         column="member_id"/>
        <result property="accountNo"        column="account_no"/>
        <result property="balance"          column="balance"/>
        <result property="createdAt"        column="created_at"/>
        <result property="updatedAt"        column="updated_at"/>
    </resultMap>

    <insert id="insert" parameterType="hello.corebanking.domain.customer.entity.PrimaryAccount"
            useGeneratedKeys="true" keyProperty="primaryAccountId">
        INSERT INTO primary_account (member_id, account_no)
        VALUES (#{memberId}, #{accountNo})
    </insert>

    <select id="findByMemberId" parameterType="long" resultMap="primaryAccountResultMap">
        SELECT primary_account_id, member_id, account_no, balance, created_at, updated_at
        FROM primary_account
        WHERE member_id = #{memberId}
    </select>

    <select id="existsByMemberId" parameterType="long" resultType="boolean">
        SELECT COUNT(*) > 0
        FROM primary_account
        WHERE member_id = #{memberId}
    </select>

</mapper>
