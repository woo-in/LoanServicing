<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="hello.corebanking.domain.product.repository.RepaymentMethodMapper">

    <resultMap id="repaymentMethodResultMap" type="hello.corebanking.domain.product.entity.RepaymentMethod">
        <id     property="repaymentMethodId" column="repayment_method_id"/>
        <result property="name"              column="name"/>
        <result property="createdAt"         column="created_at"/>
        <result property="updatedAt"         column="updated_at"/>
    </resultMap>

    <insert id="insert" parameterType="hello.corebanking.domain.product.entity.RepaymentMethod"
            useGeneratedKeys="true" keyProperty="repaymentMethodId">
        INSERT INTO repayment_method (name)
        VALUES (#{name})
    </insert>

    <select id="findById" parameterType="int" resultMap="repaymentMethodResultMap">
        SELECT repayment_method_id, name, created_at, updated_at
        FROM repayment_method
        WHERE repayment_method_id = #{repaymentMethodId}
    </select>

    <select id="findAll" resultMap="repaymentMethodResultMap">
        SELECT repayment_method_id, name, created_at, updated_at
        FROM repayment_method
        ORDER BY repayment_method_id
    </select>

</mapper>
